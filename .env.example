# Server-side environment variables for the api/ serverless functions.
# Copy this file to .env.local for local development (`vercel dev`) and fill in
# real values there. Never commit real keys. In production, set these in the
# Vercel dashboard (Project -> Settings -> Environment Variables).

# Cohere API key used by api/chat.js (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your-cohere-api-key-here

# Optional: comma-separated browser origins allowed to call /api/chat from a
# different origin, e.g. when running `flutter run -d chrome --web-port 8080`.
# Leave empty in production (the deployed site is same-origin).
ALLOWED_ORIGINS=
